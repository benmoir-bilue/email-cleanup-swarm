# Path to the Google OAuth client secret JSON you downloaded from the GCP console.
# Create an OAuth 2.0 Client ID of type "Desktop app".
ECS_CLIENT_SECRET=/path/to/client_secret_xxx.apps.googleusercontent.com.json

# Anthropic credentials. If you've run `ant auth login` you can leave this unset —
# the SDK resolves the OAuth profile automatically.
# ANTHROPIC_API_KEY=sk-ant-...
